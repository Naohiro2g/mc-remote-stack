{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Naohiro2g/scratch-editor/packages/scratch-gui/contracts/runtime-config/schema.json",
  "title": "McRemote Scratch deployment runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "connection_enabled"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "connection_enabled": {
      "type": "boolean"
    },
    "bridge_url": {
      "type": "string",
      "minLength": 1
    },
    "default_sandbox": {
      "type": "string",
      "minLength": 1
    },
    "connection_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "sandbox"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "sandbox": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "wirescope_url": {
      "type": "string",
      "minLength": 1
    },
    "notices": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/notice"
      }
    },
    "storage_persist_enabled": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "connection_enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "bridge_url": {},
          "default_sandbox": {},
          "connection_targets": {}
        },
        "required": [
          "bridge_url",
          "default_sandbox",
          "connection_targets"
        ]
      }
    }
  ],
  "definitions": {
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "body"
      ],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "link": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "href",
            "label"
          ],
          "properties": {
            "href": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
