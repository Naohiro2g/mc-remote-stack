{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mc-remote.example/schemas/compatibility-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record", "subject", "claims", "evidence"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "test_class", "result", "verified_at"],
      "properties": {
        "id": {
          "$ref": "#/$defs/recordId"
        },
        "test_class": {
          "enum": ["unit/deterministic", "live-auto", "live-human"]
        },
        "result": {
          "const": "pass"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset_ref",
        "preset_sha256",
        "profile_ref",
        "profile_sha256",
        "component_set_sha256"
      ],
      "properties": {
        "preset_ref": {
          "$ref": "#/$defs/exactRef"
        },
        "preset_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile_ref": {
          "$ref": "#/$defs/exactRef"
        },
        "profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "component_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "constraint"],
        "properties": {
          "id": {
            "$ref": "#/$defs/token"
          },
          "constraint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit", "path"],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "artifact_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "recordId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,126}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "exactRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}@[1-9][0-9]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
