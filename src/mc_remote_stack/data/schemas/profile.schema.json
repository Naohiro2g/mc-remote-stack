{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mc-remote.example/schemas/profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "capabilities",
    "environment",
    "policy",
    "renderer",
    "services",
    "volume_roles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provided", "required_component_roles"],
      "properties": {
        "provided": {
          "$ref": "#/$defs/nonemptyTokens"
        },
        "required_component_roles": {
          "$ref": "#/$defs/nonemptyTokens"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_channels", "allowed_exposures", "allowed_purposes"],
      "properties": {
        "allowed_channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["stable", "beta", "alpha", "dev"]
          }
        },
        "allowed_exposures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["public", "lan-only", "isolated"]
          }
        },
        "allowed_purposes": {
          "$ref": "#/$defs/nonemptyTokens"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_security_controls", "instance_fields", "override_allowlist"],
      "properties": {
        "required_security_controls": {
          "$ref": "#/$defs/nonemptyTokens"
        },
        "instance_fields": {
          "$ref": "#/$defs/nonemptyPaths"
        },
        "override_allowlist": {
          "$ref": "#/$defs/nonemptyPaths"
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision"],
      "properties": {
        "name": {
          "$ref": "#/$defs/token"
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "operator_input_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "adapter", "required"],
        "properties": {
          "id": {
            "$ref": "#/$defs/token"
          },
          "adapter": {
            "$ref": "#/$defs/exactRef"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role"],
        "properties": {
          "id": {
            "$ref": "#/$defs/token"
          },
          "role": {
            "$ref": "#/$defs/token"
          }
        }
      }
    },
    "volume_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {
            "$ref": "#/$defs/token"
          },
          "kind": {
            "enum": ["world", "runtime-data", "backup", "cache"]
          }
        }
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "exactRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}@[1-9][0-9]*$"
    },
    "nonemptyTokens": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "nonemptyPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
      }
    }
  }
}
