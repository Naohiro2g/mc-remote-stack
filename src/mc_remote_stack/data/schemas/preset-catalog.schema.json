{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mc-remote.example/schemas/preset-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "preset_catalog"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "preset_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "canonicalization", "source_sha256", "presets"],
      "properties": {
        "generator": {
          "const": "mcrctl-preset-catalog-v1"
        },
        "canonicalization": {
          "const": "jcs-rfc8785-v1"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "presets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "content_sha256",
              "description",
              "status",
              "available_since",
              "required_profile_capabilities",
              "allowed_channels",
              "compatibility_status",
              "compatibility_records"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/exactRef"
              },
              "content_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": ["active", "deprecated", "eol"]
              },
              "available_since": {
                "$ref": "#/$defs/date"
              },
              "deprecated_since": {
                "$ref": "#/$defs/date"
              },
              "eol_since": {
                "$ref": "#/$defs/date"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "replacement": {
                "$ref": "#/$defs/exactRef"
              },
              "required_profile_capabilities": {
                "$ref": "#/$defs/tokens"
              },
              "allowed_channels": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": ["stable", "beta", "alpha", "dev"]
                }
              },
              "compatibility_status": {
                "enum": ["verified", "unverified"]
              },
              "compatibility_records": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "exactRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}@[1-9][0-9]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      }
    }
  }
}
