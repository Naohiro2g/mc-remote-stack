{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mc-remote.example/schemas/lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lock_identity",
    "resolved_at",
    "resolver",
    "input",
    "deployment",
    "environment",
    "runtime",
    "world",
    "network",
    "agreements",
    "source_precedence",
    "selection",
    "preset_lifecycle",
    "compatibility",
    "acknowledgements",
    "operator_inputs",
    "components",
    "artifacts",
    "render_plan",
    "secret_references",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "lock_identity": {
      "$ref": "#/$defs/prefixedSha256"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "lock_schema", "canonicalization"],
      "properties": {
        "name": {
          "const": "mcrctl"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "lock_schema": {
          "const": 1
        },
        "canonicalization": {
          "const": "jcs-rfc8785-v1"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "profile", "preset"],
      "properties": {
        "order": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic_sha256"],
          "properties": {
            "semantic_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "profile": {
          "$ref": "#/$defs/refAndDigest"
        },
        "preset": {
          "$ref": "#/$defs/refAndDigest"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "profile"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "$ref": "#/$defs/exactRef"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "channel", "exposure", "purpose"],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "enum": ["stable", "beta", "alpha", "dev"]
        },
        "exposure": {
          "enum": ["public", "lan-only", "isolated"]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_store", "volumes"],
      "properties": {
        "artifact_store": {
          "type": "string",
          "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "volumes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "identity"],
            "properties": {
              "role": {
                "$ref": "#/$defs/token"
              },
              "identity": {
                "$ref": "#/$defs/token"
              }
            }
          }
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bind_address", "java_port", "mcremote_port"],
      "properties": {
        "bind_address": {
          "type": "string",
          "format": "ipv4"
        },
        "java_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "mcremote_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "agreements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minecraft_eula"],
      "properties": {
        "minecraft_eula": {
          "const": true
        }
      }
    },
    "source_precedence": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "const": "profile"
        },
        {
          "const": "preset"
        },
        {
          "const": "order"
        },
        {
          "const": "override"
        }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["preset", "custom"]
        }
      }
    },
    "preset_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["active", "deprecated", "eol"]
        },
        "warning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "required_claims_sha256",
        "component_set_sha256",
        "records"
      ],
      "properties": {
        "status": {
          "enum": ["verified", "unverified"]
        },
        "required_claims_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "component_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "content_sha256", "claims", "evidence"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,126}$"
              },
              "content_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "claims": {
                "$ref": "#/$defs/tokens"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["repository", "commit", "path"],
                  "properties": {
                    "repository": {
                      "type": "string",
                      "minLength": 1
                    },
                    "commit": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "artifact_sha256": {
                      "$ref": "#/$defs/sha256"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "acknowledgements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_unverified", "unverified_reason", "allow_eol", "eol_reason"],
      "properties": {
        "allow_unverified": {
          "type": "boolean"
        },
        "unverified_reason": {
          "type": "string"
        },
        "allow_eol": {
          "type": "boolean"
        },
        "eol_reason": {
          "type": "string"
        }
      }
    },
    "operator_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/operatorInput"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "artifact"],
        "properties": {
          "id": {
            "$ref": "#/$defs/token"
          },
          "role": {
            "$ref": "#/$defs/token"
          },
          "artifact": {
            "$ref": "#/$defs/token"
          },
          "protocol": {
            "type": "string",
            "minLength": 1
          },
          "minecraft_version": {
            "$ref": "#/$defs/minecraftVersion"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/ociArtifact"
          },
          {
            "$ref": "#/$defs/httpsArtifact"
          },
          {
            "$ref": "#/$defs/gitBuildArtifact"
          },
          {
            "$ref": "#/$defs/recoveryMemberArtifact"
          },
          {
            "$ref": "#/$defs/staticArchiveArtifact"
          }
        ]
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scratch_release_notice"],
      "properties": {
        "scratch_release_notice": {
          "$ref": "#/$defs/scratchNotice"
        }
      }
    },
    "scratch_runtime_contract": {
      "$ref": "#/$defs/scratchRuntimeContract"
    },
    "render_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "adapter_revision",
        "semantic_sha256",
        "services",
        "volume_roles",
        "required_security_controls",
        "operator_input_roles",
        "operator_inputs"
      ],
      "properties": {
        "adapter": {
          "$ref": "#/$defs/token"
        },
        "adapter_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role"],
            "properties": {
              "id": {
                "$ref": "#/$defs/token"
              },
              "role": {
                "$ref": "#/$defs/token"
              }
            }
          }
        },
        "volume_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind"],
            "properties": {
              "id": {
                "$ref": "#/$defs/token"
              },
              "kind": {
                "enum": ["world", "runtime-data", "security-state", "backup", "cache"]
              }
            }
          }
        },
        "required_security_controls": {
          "$ref": "#/$defs/tokens"
        },
        "operator_input_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/operatorInputRole"
          }
        },
        "operator_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/operatorInput"
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scratch_release_notice"],
          "properties": {
            "scratch_release_notice": {
              "$ref": "#/$defs/scratchNotice"
            }
          }
        },
        "scratch_runtime_contract": {
          "$ref": "#/$defs/scratchRuntimeContract"
        }
      }
    },
    "secret_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "usage"],
        "properties": {
          "id": {
            "$ref": "#/$defs/token"
          },
          "usage": {
            "$ref": "#/$defs/token"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_values", "secret_injected_bytes", "runtime_owned_state"],
      "properties": {
        "secret_values": {
          "const": "excluded"
        },
        "secret_injected_bytes": {
          "const": "excluded"
        },
        "runtime_owned_state": {
          "const": "excluded"
        }
      }
    }
  },
  "$defs": {
    "scratchRuntimeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "source_directory",
        "directory_tree_sha",
        "schema_sha256",
        "container_mount_path",
        "image_digest",
        "accepted_fixtures",
        "rejected_fixtures",
        "fixture_sha256"
      ],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_directory": {"type": "string", "minLength": 1},
        "directory_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "container_mount_path": {"type": "string", "pattern": "^/"},
        "image_digest": {"$ref": "#/$defs/prefixedSha256"},
        "accepted_fixtures": {"$ref": "#/$defs/fixturePaths"},
        "rejected_fixtures": {"$ref": "#/$defs/fixturePaths"},
        "fixture_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "fixturePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^fixtures/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"}
    },
    "scratchNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "body"],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "link": {
          "type": "object",
          "additionalProperties": false,
          "required": ["href", "label"],
          "properties": {
            "href": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "tokens": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "exactRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}@[1-9][0-9]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prefixedSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "refAndDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "content_sha256"],
      "properties": {
        "ref": {
          "$ref": "#/$defs/exactRef"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "operatorInputRole": {
      "oneOf": [
        {
          "$ref": "#/$defs/minecraftMotdRole"
        },
        {
          "$ref": "#/$defs/publicRoutesRole"
        },
        {
          "$ref": "#/$defs/minecraftServerRole"
        },
        {
          "$ref": "#/$defs/connectionTargetsRole"
        },
        {
          "$ref": "#/$defs/minecraftPluginsRole"
        },
        {
          "$ref": "#/$defs/homepageStaticRole"
        },
        {
          "$ref": "#/$defs/minecraftBackupRole"
        },
        {
          "$ref": "#/$defs/lanRoutesRole"
        }
      ]
    },
    "operatorInput": {
      "oneOf": [
        {
          "$ref": "#/$defs/minecraftMotdInput"
        },
        {
          "$ref": "#/$defs/publicRoutesInput"
        },
        {
          "$ref": "#/$defs/publicRoutesV2Input"
        },
        {
          "$ref": "#/$defs/minecraftServerInput"
        },
        {
          "$ref": "#/$defs/connectionTargetsInput"
        },
        {
          "$ref": "#/$defs/connectionTargetsV2Input"
        },
        {
          "$ref": "#/$defs/connectionTargetsV3Input"
        },
        {
          "$ref": "#/$defs/minecraftPluginsInput"
        },
        {
          "$ref": "#/$defs/homepageStaticInput"
        },
        {
          "$ref": "#/$defs/minecraftBackupInput"
        },
        {
          "$ref": "#/$defs/lanRoutesInput"
        }
      ]
    },
    "minecraftMotdRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "required"],
      "properties": {
        "id": {
          "const": "minecraft-motd"
        },
        "adapter": {
          "const": "minecraft-motd@1"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "publicRoutesRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "required"],
      "properties": {
        "id": {
          "const": "public-routes"
        },
        "adapter": {
          "enum": ["public-routes@1", "public-routes@2"]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "minecraftServerRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "required"],
      "properties": {
        "id": {
          "const": "minecraft-server"
        },
        "adapter": {
          "const": "minecraft-server@1"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "connectionTargetsRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "required"],
      "properties": {
        "id": {
          "const": "connection-targets"
        },
        "adapter": {
          "enum": ["connection-targets@1", "connection-targets@2", "connection-targets@3"]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "minecraftPluginsRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "required"],
      "properties": {
        "id": {
          "const": "minecraft-plugins"
        },
        "adapter": {
          "const": "minecraft-plugins@1"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "homepageStaticRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "required"],
      "properties": {
        "id": {
          "const": "homepage-static"
        },
        "adapter": {
          "const": "homepage-static@1"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "minecraftBackupRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "required"],
      "properties": {
        "id": {
          "const": "minecraft-backup"
        },
        "adapter": {
          "const": "minecraft-backup@1"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "lanRoutesRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "required"],
      "properties": {
        "id": {
          "const": "lan-routes"
        },
        "adapter": {
          "const": "lan-routes@1"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "lanRoutesInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "adapter", "path", "semantic_sha256", "semantic"],
      "properties": {
        "role": {
          "const": "lan-routes"
        },
        "adapter": {
          "const": "lan-routes@1"
        },
        "path": {
          "const": "operator/lan-routes/routes.toml"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "scratch_port", "bridge_port"],
          "properties": {
            "hostname": {
              "type": "string",
              "minLength": 1
            },
            "scratch_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "bridge_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "minecraftMotdInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "adapter",
        "path",
        "semantic_sha256",
        "semantic"
      ],
      "properties": {
        "role": {
          "const": "minecraft-motd"
        },
        "adapter": {
          "const": "minecraft-motd@1"
        },
        "path": {
          "const": "operator/minecraft-motd/server.properties"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["motd"],
          "properties": {
            "motd": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "publicRoutesInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "adapter",
        "path",
        "semantic_sha256",
        "semantic"
      ],
      "properties": {
        "role": {
          "const": "public-routes"
        },
        "adapter": {
          "const": "public-routes@1"
        },
        "path": {
          "const": "operator/public-routes/routes.toml"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "homepage",
            "homepage_aliases",
            "scratch",
            "bridge",
            "minecraft"
          ],
          "properties": {
            "homepage": {
              "type": "string",
              "minLength": 1
            },
            "homepage_aliases": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scratch": {
              "type": "string",
              "minLength": 1
            },
            "bridge": {
              "type": "string",
              "minLength": 1
            },
            "minecraft": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "publicRoutesV2Input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "adapter",
        "path",
        "semantic_sha256",
        "semantic"
      ],
      "properties": {
        "role": {
          "const": "public-routes"
        },
        "adapter": {
          "const": "public-routes@2"
        },
        "path": {
          "const": "operator/public-routes/routes.toml"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "homepage",
            "homepage_aliases",
            "scratch",
            "bridge",
            "minecraft",
            "wirescope"
          ],
          "properties": {
            "homepage": {
              "type": "string",
              "minLength": 1
            },
            "homepage_aliases": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scratch": {
              "type": "string",
              "minLength": 1
            },
            "bridge": {
              "type": "string",
              "minLength": 1
            },
            "minecraft": {
              "type": "string",
              "minLength": 1
            },
            "wirescope": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "minecraftServerInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "adapter",
        "path",
        "semantic_sha256",
        "semantic"
      ],
      "properties": {
        "role": {
          "const": "minecraft-server"
        },
        "adapter": {
          "const": "minecraft-server@1"
        },
        "path": {
          "const": "operator/minecraft-server/server.toml"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allow_flight",
            "difficulty",
            "enable_query",
            "enable_status",
            "force_gamemode",
            "gamemode",
            "hardcore",
            "log_ips",
            "management_server_enabled",
            "max_players",
            "max_tick_time",
            "max_world_size",
            "motd",
            "network_compression_threshold",
            "simulation_distance",
            "spawn_protection",
            "view_distance",
            "white_list"
          ],
          "properties": {
            "allow_flight": {"type": "boolean"},
            "difficulty": {
              "enum": ["peaceful", "easy", "normal", "hard"]
            },
            "enable_query": {"const": false},
            "enable_status": {"type": "boolean"},
            "force_gamemode": {"type": "boolean"},
            "gamemode": {
              "enum": ["survival", "creative", "adventure", "spectator"]
            },
            "hardcore": {"type": "boolean"},
            "log_ips": {"type": "boolean"},
            "management_server_enabled": {"const": false},
            "max_players": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "max_tick_time": {
              "anyOf": [
                {"const": -1},
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            },
            "max_world_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 29999984
            },
            "motd": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "network_compression_threshold": {
              "type": "integer",
              "minimum": -1,
              "maximum": 1024
            },
            "simulation_distance": {
              "type": "integer",
              "minimum": 3,
              "maximum": 32
            },
            "spawn_protection": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "view_distance": {
              "type": "integer",
              "minimum": 3,
              "maximum": 32
            },
            "white_list": {"type": "boolean"}
          }
        }
      }
    },
    "connectionTargetsInput": {
