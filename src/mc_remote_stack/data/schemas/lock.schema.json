    "minecraftPluginsInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "adapter", "path", "semantic_sha256", "semantic"],
      "properties": {
        "role": {
          "const": "minecraft-plugins"
        },
        "adapter": {
          "const": "minecraft-plugins@1"
        },
        "path": {
          "const": "operator/minecraft-plugins/plugins.toml"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugins"],
          "properties": {
            "plugins": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["filename", "sha256"],
                "properties": {
                  "filename": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,126}\\.jar$"
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            }
          }
        }
      }
    },
    "homepageStaticInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "adapter", "path", "semantic_sha256", "semantic"],
      "properties": {
        "role": {
          "const": "homepage-static"
        },
        "adapter": {
          "const": "homepage-static@1"
        },
        "path": {
          "const": "operator/homepage-static/homepage.toml"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tree_sha256", "file_count", "total_bytes"],
          "properties": {
            "tree_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "file_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "total_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 134217728
            }
          }
        }
      }
    },
    "minecraftBackupInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "adapter", "path", "semantic_sha256", "semantic"],
      "properties": {
        "role": {
          "const": "minecraft-backup"
        },
        "adapter": {
          "const": "minecraft-backup@1"
        },
        "path": {
          "const": "operator/minecraft-backup/backup.toml"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host_path"],
          "properties": {
            "host_path": {
              "type": "string",
              "pattern": "^/[^\\u0000]*$"
            }
          }
        }
      }
    },
    "safeFilename": {
      "type": "string",
      "pattern": "^[^/\\\\]+$",
      "minLength": 1
    },
    "minecraftVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "ociArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "version", "locator", "digest"],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "kind": {
          "const": "oci"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "pattern": "^[^@\\s]+$"
        },
        "digest": {
          "$ref": "#/$defs/prefixedSha256"
        }
      }
    },
    "httpsArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "version", "filename", "sha256", "origin"],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "kind": {
          "const": "https-file"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "$ref": "#/$defs/safeFilename"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "origin": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "gitBuildArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "repository",
        "commit",
        "source_subdirectory",
        "recipe",
        "recipe_sha256",
        "toolchain",
        "toolchain_sha256",
        "build_input_sha256",
        "output_filename",
        "output_sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "kind": {
          "const": "git-build"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "$ref": "#/$defs/httpsUrl"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_subdirectory": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "recipe": {
          "type": "string",
          "minLength": 1
        },
        "recipe_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "toolchain_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "build_input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_filename": {
          "$ref": "#/$defs/safeFilename"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "recoveryMemberArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "archive_sha256",
        "member",
        "output_filename",
        "output_sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "kind": {
          "const": "recovery-archive-member"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "member": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "output_filename": {
          "$ref": "#/$defs/safeFilename"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "staticArchiveArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "version", "archive_sha256", "format", "origin", "excluded"],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "kind": {
          "const": "static-archive"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "enum": ["zip", "tar", "tar.gz"]
        },
        "origin": {
          "$ref": "#/$defs/httpsUrl"
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        }
      }
    }
  }
}
