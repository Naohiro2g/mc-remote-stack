    "connectionTargetsV2Input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "adapter",
        "path",
        "semantic_sha256",
        "semantic"
      ],
      "properties": {
        "role": {
          "const": "connection-targets"
        },
        "adapter": {
          "const": "connection-targets@2"
        },
        "path": {
          "const": "operator/connection-targets/targets.toml"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targets", "notices"],
          "properties": {
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "sandbox"],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/token"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "sandbox": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "notices": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["heading", "body", "link"],
                "properties": {
                  "heading": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "link": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["href", "label"],
                    "properties": {
                      "href": {
                        "type": "string",
                        "pattern": "^https://",
                        "maxLength": 2048
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
