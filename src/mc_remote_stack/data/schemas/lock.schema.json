          "required": ["targets"],
          "properties": {
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "sandbox"],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/token"
                  },
                  "label": {
                    "type": "string",
